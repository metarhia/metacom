{
  "name": "metacom",
  "version": "3.2.6",
  "author": "Timur Shemsedinov <timur.shemsedinov@gmail.com>",
  "contributors": [
    "Oleksandr Korneiko <oleksandr.korneiko@gmail.com>"
  ],
  "description": "Communication protocol for Metarhia stack with rpc, events, binary streams, memory and db access",
  "license": "MIT",
  "keywords": [
    "metacom",
    "metarhia",
    "impress",
    "server",
    "client",
    "socket",
    "websocket",
    "rpc",
    "events",
    "sync",
    "globalstorage",
    "protocol",
    "stream"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/metarhia/metacom"
  },
  "bugs": {
    "url": "https://github.com/metarhia/metacom/issues",
    "email": "timur.shemsedinov@gmail.com"
  },
  "homepage": "https://metarhia.com",
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/tshemsedinov"
  },
  "main": "metacom.js",
  "types": "metacom.d.ts",
  "imports": {
    "#metacom": "./metacom.js",
    "#ws": "./lib/websocket/ws.js"
  },
  "browser": {
    "./metacom.js": "./metacom.mjs"
  },
  "files": [
    "lib/",
    "metacom.mjs",
    "metacom.d.ts",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "readmeFilename": "README.md",
  "scripts": {
    "build": "metarhia-build lib",
    "test": "npm run -s lint && npm run types && node --test",
    "bench": "node benchmarks/encoders-benchmark.js",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,json,md,mdx,yaml,yml}\"",
    "fix": "eslint . --fix && prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,json,md,mdx,yaml,yml}\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "metautil": "^5.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-metarhia": "^10.0.1",
    "metarhia-build": "^0.0.3",
    "metaskills": "^1.0.6",
    "prettier": "^3.10.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
